#!/usr/bin/env node
// The `hark` CLI — the per-project task board. Thin by design: parsing,
// execution, and rendering live in src/lib/board/boardCli.ts and are
// unit-tested; this file only does argv splitting + IO.
//
// It imports the COMPILED helpers from ../dist (relative to this file, so it
// works from any cwd). Run `npm run build` first. The board acts directly on
// its SQLite source of truth — no server round-trip, fully offline.
import {
  BoardStore,
  ensureProjectBoardDb,
  findProjectRoot,
} from "../dist/lib/board/boardStore.js";
import {
  planBoard,
  applyBoardOp,
  renderBoardResult,
} from "../dist/lib/board/boardCli.js";

const USAGE = `hark — Claude Code session manager

  hark board <add|list|show|set|link|assign|close>   per-project task board
  hark board --help                                  full board usage
`;

function main() {
  const argv = process.argv.slice(2);
  const [group, ...rest] = argv;

  if (!group || group === "help" || group === "--help" || group === "-h") {
    process.stdout.write(USAGE);
    return 0;
  }
  if (group !== "board") {
    process.stderr.write(`hark: unknown command "${group}" — only "board" is supported\n`);
    return 2;
  }

  // Split flags (-x / --x) from positionals; board field=value args are
  // positionals (they don't start with "-"), so this split is all planBoard needs.
  const positionals = [];
  const flags = {};
  for (const tok of rest) {
    if (tok.startsWith("-")) flags[tok] = true;
    else positionals.push(tok);
  }

  const plan = planBoard(positionals, flags);
  if (plan.kind === "message") {
    process.stdout.write(plan.text + "\n");
    return 0;
  }
  if (plan.kind === "error") {
    process.stderr.write(`hark: ${plan.message}\n`);
    return 2;
  }

  // Per-project: resolve the project root from cwd and open that project's own
  // board.db (migrating a legacy global board into place on first open).
  const store = new BoardStore(ensureProjectBoardDb(findProjectRoot(process.cwd())));
  try {
    const result = applyBoardOp(store, plan.op);
    process.stdout.write(renderBoardResult(result) + "\n");
    return 0;
  } finally {
    store.close();
  }
}

try {
  process.exit(main());
} catch (e) {
  process.stderr.write(`hark: ${e && e.stack ? e.stack : e}\n`);
  process.exit(1);
}
