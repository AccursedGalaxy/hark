{
  "name": "hark",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "hark": "./bin/hark"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently --names server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web && tsc",
    "start": "node dist/server.js",
    "install-hooks": "tsx src/bin/install-hooks.ts",
    "uninstall-hooks": "tsx src/bin/install-hooks.ts --uninstall",
    "install-service": "tsx src/bin/install-service.ts",
    "uninstall-service": "tsx src/bin/install-service.ts --uninstall",
    "test": "vitest run",
    "test:memory": "NODE_OPTIONS=--expose-gc vitest run src/lib/memoryRegression.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "compression": "^1.8.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "concurrently": "^9.2.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.7"
  }
}
